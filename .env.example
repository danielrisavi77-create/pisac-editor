# Live inference is opt-in. Provider keys alone do not activate the public endpoint.
AI_ARCHITECT_LIVE_ENABLED=false

# Server-side only. Never place these values in public/ JavaScript.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Reserved for a future learned router after readiness gates pass.
NOTDIAMOND_API_KEY=

AI_ARCHITECT_SITE_URL=
AI_ARCHITECT_APP_NAME=Pisac AI Architect

# AI Router service-to-service protection.
AI_ROUTER_SHARED_SECRET=

# Optional privacy-first telemetry and self-calibration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_ROUTER_LOG_PREVIEWS=false

# Optional abuse guard. Instance-local only until V2.1 distributed limiting is enabled.
AI_ROUTER_RATE_LIMIT_PER_MINUTE=60

# Optional JSON array overriding the default multi-provider registry.
AI_ROUTER_CATALOG_JSON=
