# Public live inference remains OFF until identity + per-user quotas + distributed rate limiting exist.
AI_ARCHITECT_LIVE_ENABLED=false
AI_ARCHITECT_USAGE_POLICY_READY=false

# Server-side provider credentials. Never expose these in public/ assets.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Durable AI Architect outcome/calibration store (optional until migration is applied).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for a future learned router after readiness gates pass.
NOTDIAMOND_API_KEY=

AI_ARCHITECT_SITE_URL=
AI_ARCHITECT_APP_NAME=Pisac AI Architect

# Supabase auth (public/anon values only; never the service role key).
NEXT_PUBLIC_SUPABASE_URL=
# Anon key from Supabase project settings; safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical public origin used for magic-link redirects (optional in dev).
NEXT_PUBLIC_SITE_URL=

# RATE LIMITS — where they actually live.
# `src/lib/rate/limiter.ts` gives the magic-link action a per-process, in-memory
# cooldown (1 send per address per minute) and burst cap (5 sends per minute).
# It is BEST EFFORT ONLY: each serverless instance starts with an empty map and
# a full bucket, so the real ceiling is (instances x 5)/min. The limits that
# hold are configured OUTSIDE this file:
#   - Supabase → Authentication → Rate Limits (e-mails per hour, per address),
#   - the SMTP provider's own sending limits,
#   - an edge/WAF rule in front of the deployment for per-IP request limits.
# Configure those before the site is public; do not treat the app-layer limiter
# as a substitute for them.
