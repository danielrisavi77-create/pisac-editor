# Live inference is opt-in. Provider keys alone do not activate the public endpoint.
AI_ARCHITECT_LIVE_ENABLED=false

# Server-side only. Never place these values in public/ JavaScript.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Reserved for a future learned router after readiness gates pass.
NOTDIAMOND_API_KEY=

AI_ARCHITECT_SITE_URL=
AI_ARCHITECT_APP_NAME=Pisac AI Architect

# AI Router service-to-service protection and telemetry.
AI_ROUTER_SHARED_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_ROUTER_LOG_PREVIEWS=false

# Optional JSON array overriding the AI Router bootstrap model catalog.
AI_ROUTER_CATALOG_JSON=
