# Public live inference remains OFF until identity + per-user quotas + distributed rate limiting exist.
AI_ARCHITECT_LIVE_ENABLED=false
AI_ARCHITECT_USAGE_POLICY_READY=false

# Server-side provider credentials. Never expose these in public/ assets.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Durable AI Architect outcome/calibration store (optional until migration is applied).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for a future learned router after readiness gates pass.
NOTDIAMOND_API_KEY=

AI_ARCHITECT_SITE_URL=
AI_ARCHITECT_APP_NAME=Pisac AI Architect

# Supabase auth (public/anon values only; never the service role key).
NEXT_PUBLIC_SUPABASE_URL=
# Anon key from Supabase project settings; safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical public origin used for magic-link redirects (optional in dev).
NEXT_PUBLIC_SITE_URL=
