{
  "schemaVersion": 2,
  "strategy": "adaptive",
  "learning": {
    "minEvaluatedSamples": 3,
    "qualityGateRequired": true,
    "notDiamondMinOutcomes": 50
  },
  "providers": {
    "openrouter": {
      "enabled": true,
      "keyEnv": "OPENROUTER_API_KEY",
      "defaultModel": "openrouter/auto"
    },
    "openai": {
      "enabled": true,
      "keyEnv": "OPENAI_API_KEY",
      "defaultModel": "gpt-5.6-terra"
    },
    "anthropic": {
      "enabled": true,
      "keyEnv": "ANTHROPIC_API_KEY",
      "defaultModel": "claude-sonnet-5",
      "apiVersion": "2023-06-01"
    },
    "gemini": {
      "enabled": true,
      "keyEnv": "GEMINI_API_KEY",
      "defaultModel": "gemini-3.8-flash"
    },
    "local": {
      "enabled": true,
      "defaultModel": "local/mock",
      "testOnly": true
    },
    "notdiamond": {
      "enabled": false,
      "keyEnv": "NOTDIAMOND_API_KEY",
      "minOutcomes": 50,
      "minPerTask": 8
    }
  },
