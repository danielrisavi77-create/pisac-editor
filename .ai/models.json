{
  "schemaVersion": 3,
  "registry": {
    "source": "tools/ai-architect/src/model-registry.mjs",
    "version": "2026-09-19"
  },
  "strategy": "verified-cost-routing",
  "learning": {
    "minVerifiedSamples": 30,
    "minTokenCalibrationSamples": 20,
    "requireKnownCostForPromotion": true,
    "requireQualityGate": true
  },
  "providers": {
    "openrouter": {
      "enabled": true,
      "keyEnv": "OPENROUTER_API_KEY"
    },
    "openai": {
      "enabled": true,
      "keyEnv": "OPENAI_API_KEY"
    },
    "anthropic": {
      "enabled": true,
      "keyEnv": "ANTHROPIC_API_KEY",
      "apiVersion": "2023-06-01"
    },
    "gemini": {
      "enabled": true,
      "keyEnv": "GEMINI_API_KEY"
    },
    "xai": {
      "enabled": true,
      "keyEnv": "XAI_API_KEY"
    },
    "local": {
      "enabled": true,
      "testOnly": true
    },
    "notdiamond": {
      "enabled": false,
      "keyEnv": "NOTDIAMOND_API_KEY",
      "minOutcomes": 100,
      "minPerTask": 30
    }
  },
  "productionTiers": {
    "low": [
      "gemini:gemini-3.5-flash-lite",
      "openai:gpt-5.6-luna",
      "anthropic:claude-haiku-4-5-20251001",
      "local:local/mock"
    ],
    "medium": [
      "gemini:gemini-3.8-flash",
      "openai:gpt-5.6-terra",
      "anthropic:claude-sonnet-5",
      "xai:grok-4.6",
      "local:local/mock"
    ],
    "high": [
      "openai:gpt-5.6-sol",
      "anthropic:claude-opus-5",
      "xai:grok-4.6",
      "gemini:gemini-3.8-flash",
      "local:local/mock"
    ],
    "critical": [
      "openai:gpt-6-astra",
      "anthropic:claude-fable-5-1",
      "openai:gpt-5.6-sol",
      "anthropic:claude-opus-5",
      "xai:grok-4.6",
      "local:local/mock"
    ]
  },
  "autoRouter": {
    "enabled": true,
    "ref": "openrouter:openrouter/auto",
    "allowedTiers": [
      "low",
      "medium",
      "high"
    ],
    "requiresExplicitDynamicCostOptIn": true
  },
  "benchmarkOnlyRefs": [
    "gemini:gemini-3.1-pro-preview"
  ]
}
